    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">66a3e1cd-f2bc-472c-bb00-6122afe54ca2</Single>
        <Single Name="ParentGuid" Type="System.Guid">864d5513-663c-4b17-a53b-bd34f88f3083</Single>
        <Single Name="Name" Type="string">ExtractJson</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">f8a58466-d7f6-439f-bbb8-d4600e41d099</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639231038691853335</Single>
      </Single>
      <Single Name="Object" Type="{f8a58466-d7f6-439f-bbb8-d4600e41d099}" Method="IArchivable">
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Default to empty, so every early exit below already returns the right thing.
ExtractJson := '';
sResult     := '';

pSrc := ADR(sSource);
pKey := ADR(sKey);
pRes := ADR(sResult);

// ---------------------------------------------------------------------
// Find the real lengths by scanning for the terminating zero. LEN cannot be
// used here for the same reason FIND cannot: it would stop at 255.
// Both loops are bounded by the declared buffer sizes, so a string that is
// somehow not terminated can never run off the end of memory.
// ---------------------------------------------------------------------
iKeyLen := 0;
WHILE (iKeyLen &lt; 40) AND (pKey[iKeyLen] &lt;&gt; 0) DO
	iKeyLen := iKeyLen + 1;
END_WHILE
IF iKeyLen = 0 THEN
	RETURN;							// Nothing to search for
END_IF

iSrcLen := 0;
WHILE (iSrcLen &lt; 4095) AND (pSrc[iSrcLen] &lt;&gt; 0) DO
	iSrcLen := iSrcLen + 1;
END_WHILE
IF iSrcLen &lt; iKeyLen THEN
	RETURN;							// Answer is shorter than the key, so it cannot contain it
END_IF

// ---------------------------------------------------------------------
// Plain substring search across the whole buffer. Naive on purpose: the
// answers are a few kilobytes at most and this runs twice per message, so
// clarity is worth more here than a cleverer algorithm.
// ---------------------------------------------------------------------
iHit := -1;
iPos := 0;
WHILE (iPos &lt;= (iSrcLen - iKeyLen)) AND (iHit &lt; 0) DO
	xMatch := TRUE;
	iSub   := 0;
	WHILE (iSub &lt; iKeyLen) AND xMatch DO
		IF pSrc[iPos + iSub] &lt;&gt; pKey[iSub] THEN
			xMatch := FALSE;		// Mismatch, stop comparing and slide along
		END_IF
		iSub := iSub + 1;
	END_WHILE
	IF xMatch THEN
		iHit := iPos + iKeyLen;		// First character after the key
	END_IF
	iPos := iPos + 1;
END_WHILE

IF iHit &lt; 0 THEN
	RETURN;							// Key is not in this answer
END_IF

// ---------------------------------------------------------------------
// The next double quote after the key opens the value. Skipping forward to
// it rather than expecting a specific separator is what makes the parser
// tolerant of whitespace between the colon and the value.
// ---------------------------------------------------------------------
WHILE (iHit &lt; iSrcLen) AND (pSrc[iHit] &lt;&gt; 34) DO
	iHit := iHit + 1;
END_WHILE
IF iHit &gt;= iSrcLen THEN
	RETURN;							// No opening quote, so this is not a string value
END_IF
iHit := iHit + 1;					// Step onto the first character of the value itself

// ---------------------------------------------------------------------
// Copy until the closing quote. The output is capped at the size of the
// result buffer, and the terminator is written afterwards so the value is a
// valid IEC string whatever happens.
// ---------------------------------------------------------------------
iOut := 0;
WHILE (iHit &lt; iSrcLen) AND (pSrc[iHit] &lt;&gt; 34) AND (iOut &lt; 200) DO
	pRes[iOut] := pSrc[iHit];
	iOut       := iOut + 1;
	iHit       := iHit + 1;
END_WHILE
pRes[iOut] := 0;

ExtractJson := sResult;</Single>
            <Single Name="LineInfoPersistence" Type="string">66a3e1cd-f2bc-472c-bb00-6122afe54ca2_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">(*
	ExtractJson                       Created 20.08.2026, rewritten 22.08.2026
	==========================================================================
	WHAT IT DOES
	Pulls the string value that belongs to a JSON key out of a raw HTTP answer.
	Used twice in this block: to lift the bearer token out of the login answer,
	and the modem id out of the modem status answer.

	HOW TO CALL IT
	sKey is the bare quoted key WITHOUT the colon, so the four characters that
	spell out id surrounded by quotes. The scanner then skips whatever separator
	follows, which means both of these parse correctly:
	    "id":"3-1"          compact
	    "id": "3-1"         with whitespace
	An empty string comes back when the key is not present, so the caller can
	simply test the length.

	*** WHY THIS IS A BYTE SCANNER AND NOT FIND AND MID ***
	The CODESYS standard string functions FIND, MID, LEFT and CONCAT are all
	declared with STRING(255) parameters. Handed a longer buffer they quietly
	look at the first 255 characters only, with no warning and no error.
	sResponse is STRING(4095). The login answer is short, so the token was
	always found and everything looked fine. But the modem status answer
	carries many fields per modem, and the id can sit past character 255 - so
	the lookup silently returned nothing, the block fell back to modem 1-1, and
	the router replied HTTP 422 Provided modem does not exist. Meanwhile the
	awk based shell script, which has no such limit, found 3-1 without trouble.

	This version walks the raw bytes through pointers instead, so the whole
	buffer is searched. The same approach is worth reaching for anywhere a long
	HTTP answer has to be parsed in ST.

	Character code 34 is the double quote, written numerically to keep the
	string literals in this method readable.
*)
METHOD ExtractJson : STRING(200)
VAR_INPUT
	sSource	: STRING(4095);		// Raw JSON body straight from the router
	sKey	: STRING(40);		// Quoted key to look for, without the colon
END_VAR
VAR
	pSrc	: POINTER TO BYTE;	// Walks sSource byte by byte
	pKey	: POINTER TO BYTE;	// Walks sKey during the comparison
	pRes	: POINTER TO BYTE;	// Writes into the result buffer
	iSrcLen	: INT;				// Real length of sSource, found by scanning for the terminator
	iKeyLen	: INT;				// Real length of sKey
	iPos	: INT;				// Current scan position in sSource
	iSub	: INT;				// Position inside the key while comparing
	iHit	: INT;				// Index just past the matched key. -1 means not found.
	iOut	: INT;				// Characters written to the result so far
	xMatch	: BOOL;				// Does the key match at the current position
	sResult	: STRING(200);		// Value being assembled, copied to the return at the end
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">66a3e1cd-f2bc-472c-bb00-6122afe54ca2_Decl_LineIds</Single>
          </Single>
        </Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">864d5513-663c-4b17-a53b-bd34f88f3083</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">Teltonika</Single>
        <Single Type="string">FbTeltonikaSMS</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
