              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639231152743642798</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// =====================================================================
// Turn the operator setting into the value the timer needs.
// The visualization writes whole seconds into iDelaySec, because a text
// field cannot write a TIME and the %d placeholder on a TIME would show raw
// milliseconds. Clamping happens here so a typing mistake in the screen can
// never produce a negative time or mute an alarm for days.
// =====================================================================
IF iDelaySec &lt; 0 THEN
	iDelaySec := 0;
ELSIF iDelaySec &gt; DELAY_MAX_SEC THEN
	iDelaySec := DELAY_MAX_SEC;
END_IF

tOnDelay := UDINT_TO_TIME(INT_TO_UDINT(iDelaySec) * 1000);

// Readable version for the screen. Whole minutes above a minute, seconds
// below it. Any remaining seconds are dropped on purpose: the field is a
// quick overview, and the exact value is always visible in iDelaySec.
IF iDelaySec &lt; 60 THEN
	sDelayText := CONCAT(INT_TO_STRING(iDelaySec), ' s');
ELSE
	sDelayText := CONCAT(INT_TO_STRING(iDelaySec / 60), ' min');
END_IF

// =====================================================================
// Debounce.
// The timer only reaches Q once the raw signal has been TRUE continuously
// for tOnDelay. A signal that drops out in the meantime restarts it, so a
// brief glitch never becomes a text message in the middle of the night.
// =====================================================================
TON_Delay(IN := xAlarmIn, PT := tOnDelay);
xActive := TON_Delay.Q;

// =====================================================================
// Edge detection on the DEBOUNCED state, not on the raw input.
// Both outputs are true for a single call only. Deriving them here means the
// caller never has to keep its own edge memory, and cannot get it wrong.
// =====================================================================
xRising  := xActive AND NOT xPrev;
xFalling := (NOT xActive) AND xPrev;

// Remember the state for the next call. This runs unconditionally: even when
// the alarm is muted its state must keep tracking, otherwise unmuting it
// later would produce a false edge for a fault that was already standing.
xPrev := xActive;</Single>
            <Single Name="LineInfoPersistence" Type="string">b8530557-6c0e-474d-ab65-46f957e1d0ad_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">(*
	FbAlarmSlot                         Created 22.08.2026, rev 23.08.2026
	==========================================================================
	WHAT THIS BLOCK IS
	One alarm slot. It holds both the configuration for a single alarm and the
	live state of that alarm, and it does its own debouncing and edge detection.
	prg_AlarmSMS keeps an array of twenty of these.

	WHY A FUNCTION BLOCK AND NOT PARALLEL ARRAYS
	The CODESYS Best Practices for visualization recommend passing ONE parameter
	to a reusable visualization, ideally a function block instance, through
	VAR_IN_OUT so the instance is not copied. With one instance per alarm, a
	frame that shows one row needs a single reference:

	    alarm  -&gt;  prg_AlarmSMS.aAlarm[7]

	instead of one reference per field. The same document also advises keeping
	object state inside the function block rather than in the visualization,
	which is why the debounce timer and the edge memory live here.

	EVERYTHING THE OPERATOR EDITS IS AN INPUT
	A visualization can only write to VAR_INPUT and VAR_IN_OUT. Outputs are
	display only. That is the reason the delay is entered as iDelaySec rather
	than as the TIME value itself, and the reason the recipient selection is a
	plain array of BOOL rather than a bit mask: a checkbox binds straight to
	axToRecipient[2] with no bit arithmetic anywhere.

	HOW IT IS USED
	Call the instance once per cycle with no arguments:

	    aAlarm[i]();
	    IF aAlarm[i].xRising THEN ... send an alarm message ... END_IF
*)
FUNCTION_BLOCK FbAlarmSlot
VAR_INPUT
	// === CONFIGURATION - written by the operator, usually from a visualization ===

	xSmsEnable	: BOOL  := FALSE;		// The on and off switch for this alarm. TRUE means it is
										// allowed to send an SMS, FALSE means it is still tracked
										// but stays silent. Bind a CHECKBOX to this, not a radio
										// button: each alarm is independent of the others.

	sText		: STRING(70) := '';		// The wording that ends up in the message. Keep it short:
										// the site name and time stamp are added in front, and the
										// total is capped at 140 characters. Avoid double quotes -
										// the sender replaces them with spaces so they cannot break
										// the JSON body.

	// Which of the four phone numbers this alarm goes to. One BOOL per person,
	// so a visualization binds four independent CHECKBOX elements:
	//     alarm.axToRecipient[1]   ... alarm.axToRecipient[4]
	// Radio buttons are wrong here - they are mutually exclusive, and one alarm
	// must be able to reach several people at once.
	// The size is fixed at four and must match MAX_RECIPIENTS in the program.
	axToRecipient : ARRAY[1..4] OF BOOL := [TRUE, FALSE, FALSE, FALSE];

	iDelaySec	: INT   := 30;			// Debounce time in SECONDS. How long xAlarmIn must stay
										// TRUE before it counts as a real alarm, which filters out
										// flicker and short network dropouts. This is the single
										// biggest contributor to the delay between a fault
										// appearing and the SMS arriving.
										// Seconds rather than minutes because some alarms need to
										// react inside a minute: 30 is thirty seconds, 300 is five
										// minutes. The block clamps the value to a sane range and
										// shows it back in readable form through sDelayText.

	// === PLANT SIGNAL - written by whatever logic detects the condition ===

	xAlarmIn	: BOOL;					// The raw alarm condition, TRUE means the fault is present.
										// Write it from anywhere in the project, for example:
										//   prg_AlarmSMS.aAlarm[1].xAlarmIn := NOT xPriceDataValid;
END_VAR
VAR_OUTPUT
	// === LIVE STATE - read only, produced by this block ===

	xActive		: BOOL;					// The debounced alarm state. This is the one to show on a
										// lamp, because it matches what the SMS logic reacts to.
										// xAlarmIn may flicker; xActive does not.

	xRising		: BOOL;					// TRUE for exactly one call, on the cycle where the alarm
										// became active. The owner uses this to send one message
										// rather than one per cycle for as long as the fault lasts.

	xFalling	: BOOL;					// TRUE for exactly one call, on the cycle where the alarm
										// cleared. Used for the optional message that tells the
										// operator the fault went away.

	tOnDelay	: TIME;					// iDelaySec expressed as a TIME, which is what the timer
										// actually uses. Read only: change the delay through
										// iDelaySec, not here.

	sDelayText	: STRING(12);			// The delay rendered for a screen, for example 30 s or
										// 5 min. Bind a text field to this with the %s placeholder.
END_VAR
VAR
	TON_Delay	: TON;					// Implements the debounce. Held here rather than in the
										// caller so every alarm carries its own timing with it.
	xPrev		: BOOL;					// Previous value of xActive, so the two edge outputs can be
										// derived. Without it a standing alarm would keep firing.
END_VAR
VAR CONSTANT
	DELAY_MAX_SEC : INT := 3600;		// One hour. An upper bound so a mistyped value in the
										// visualization cannot mute an alarm for days.
END_VAR</Single>
