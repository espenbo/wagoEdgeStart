    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">864d5513-663c-4b17-a53b-bd34f88f3083</Single>
        <Single Name="ParentGuid" Type="System.Guid">74e3e49e-7ef8-4c33-9830-fee5aedb6d38</Single>
        <Single Name="Name" Type="string">FbTeltonikaSMS</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">69ee38eb-31f8-40c0-8419-0949ffbab4c5</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639231152743652802</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// =====================================================================
// The FB body must run EVERY cycle, idle or not. The cURL transfer is
// asynchronous and only makes progress when this executes; skipping it
// would leave xBusy, xDone and xError frozen at their old values.
// =====================================================================
fbCurl();
uiStepOut := uiStep;

// =====================================================================
// Age the cached token out.
// The timer runs only while a token is held, so it measures the age of that
// specific token. When it expires the token is discarded and the next job
// logs in again. tTokenLifetime sits below the 299 seconds the router
// reports, so we never present a token the router has already forgotten.
// =====================================================================
TON_TokenAge(IN := xTokenValid, PT := tTokenLifetime);
IF TON_TokenAge.Q THEN
	xTokenValid := FALSE;
	sToken      := '';
END_IF

// =====================================================================
// A rising edge on xSend starts one job. A job in progress is never
// interrupted, so a caller cannot corrupt a transfer by pulsing again.
//
// The entry point depends on what is still cached. With a valid token and a
// known modem id the job starts directly at the send step, which is the whole
// point of the caching: two steps instead of eight.
// =====================================================================
IF xSend AND NOT xSendPrev AND NOT xBusy THEN
	xBusy          := TRUE;
	xDone          := FALSE;
	xError         := FALSE;
	xSendUncertain := FALSE;
	xRetriedLogin  := FALSE;	// Fresh job, so the one allowed re-login is available again
	sErrorText     := '';
	diHttpCode     := 0;

	IF xTokenValid AND (LEN(sToken) &gt; 0) THEN
		IF LEN(sModemIdForced) &gt; 0 THEN
			sModemID := sModemIdForced;
			uiStep   := 30;		// Token cached and modem pinned by the operator
		ELSIF LEN(sModemID) &gt; 0 THEN
			uiStep   := 30;		// Token cached and modem detected earlier
		ELSE
			uiStep   := 20;		// Token cached but the modem is still unknown
		END_IF
	ELSE
		uiStep := 10;			// No usable token, so start with a login
	END_IF
END_IF
xSendPrev := xSend;

// =====================================================================
// The state machine.
//
// libcurl option numbers used below, since the WAGO wrapper takes raw ints:
//   13 = TIMEOUT in seconds     47 = POST             64 = SSL_VERIFYPEER
//   78 = CONNECTTIMEOUT         80 = HTTPGET          81 = SSL_VERIFYHOST
//   10002 = URL   10015 = POSTFIELDS   10018 = USERAGENT   10023 = HTTPHEADER
//
// Certificate checking is switched off because the router presents a self
// signed certificate that no public CA vouches for. That is acceptable here
// because the traffic already runs inside the Tailscale tunnel, which does
// its own authentication and encryption.
// =====================================================================
CASE uiStep OF

	// -----------------------------------------------------------------
	0:	// Idle, waiting for a rising edge on xSend.
	// -----------------------------------------------------------------
		xBusy := FALSE;

	// -----------------------------------------------------------------
	10:	// LOGIN - start the request.
	//     Any previous token is dropped first, so a failure here cannot leave
	//     a half valid credential behind for the next job to trip over.
	// -----------------------------------------------------------------
		sStatus     := 'Steg 10: logger inn paa ruteren...';
		sResponse   := '';
		xTokenValid := FALSE;
		sToken      := '';

		fbCurl.curl_easy_init();
		fbCurl.curl_set_RAM(ADR(sResponse), SIZEOF(sResponse));		// Where the answer lands
		fbCurl.curl_easy_setopt_BOOL(64, FALSE);					// Do not verify the certificate
		fbCurl.curl_easy_setopt_BOOL(81, FALSE);					// Do not verify the host name
		fbCurl.curl_easy_setopt_DINT(13, TIME_TO_DINT(tRequestTimeout) / 1000);
		fbCurl.curl_easy_setopt_DINT(78, 10);						// Connect timeout, seconds
		fbCurl.curl_easy_setopt_DINT(47, 1);						// This is a POST

		sURL := CONCAT('https://', sRouterIP);
		sURL := CONCAT(sURL, '/api/login');
		fbCurl.curl_easy_setopt_STRING(10002, sURL);

		// The API only accepts JSON, so the content type has to be declared.
		fbCurl.curl_slist_append(1, 'Content-Type: application/json');
		fbCurl.curl_easy_setopt_slist(10023, 1);

		sBody := CONCAT('{"username":"', sUsername);
		sBody := CONCAT(sBody, '","password":"');
		sBody := CONCAT(sBody, sPassword);
		sBody := CONCAT(sBody, '"}');
		fbCurl.curl_easy_setopt_STRING(10015, sBody);

		fbCurl.curl_easy_perform();		// Starts the transfer and returns at once
		TON_Wait(IN := FALSE);			// Arm the guard timer for the wait step
		uiStep := 11;

	// -----------------------------------------------------------------
	11:	// LOGIN - wait for the answer, then pull the token out of it.
	// -----------------------------------------------------------------
		TON_Wait(IN := TRUE, PT := tWaitTimeout);
		IF fbCurl.xDone OR fbCurl.xError THEN
			TON_Wait(IN := FALSE);

			// Capture everything libcurl knows BEFORE cleaning the handle up,
			// otherwise the diagnostics are lost with it.
			diHttpCode    := LINT_TO_DINT(fbCurl.curl_easy_getResponseCode());
			xCurlError    := fbCurl.xError;
			sCurlError    := fbCurl.sErrorString;
			sCurlSource   := fbCurl.sErrorSource;
			sLastResponse := LEFT(sResponse, 200);

			// Free the header list and the handle. Skipping this leaks memory
			// and lets headers accumulate across requests.
			fbCurl.curl_slist_free_all(1);
			fbCurl.curl_easy_cleanup();

			sToken := ExtractJson(sSource := sResponse, sKey := '"token"');
			IF LEN(sToken) &gt; 0 THEN
				xTokenValid := TRUE;			// Also starts the token age timer
				udiLoginCnt := udiLoginCnt + 1;
				sStatus     := 'Token mottatt';
				IF LEN(sModemIdForced) &gt; 0 THEN
					sModemID := sModemIdForced;
					uiStep   := 30;
				ELSIF LEN(sModemID) &gt; 0 THEN
					uiStep   := 30;
				ELSE
					uiStep   := 20;
				END_IF
			ELSE
				// No token in the answer. Report the HTTP code, and add whichever
				// detail actually explains it: the router answer when there is
				// one, the libcurl reason when the transfer never got that far.
				sErrorText := CONCAT('Innlogging feilet, HTTP ', DINT_TO_STRING(diHttpCode));
				IF diHttpCode = 0 THEN
					sErrorText := CONCAT(sErrorText, ' curl: ');
					sErrorText := CONCAT(sErrorText, LEFT(sCurlError, 110));
				ELSE
					sErrorText := CONCAT(sErrorText, ' svar: ');
					sErrorText := CONCAT(sErrorText, LEFT(sResponse, 110));
				END_IF
				uiStep := 900;
			END_IF

		ELSIF TON_Wait.Q THEN
			// The transfer never reported completion. Abort it explicitly so
			// libcurl releases the connection instead of leaving it dangling.
			TON_Wait(IN := FALSE);
			fbCurl.curl_easy_abort();
			fbCurl.curl_slist_free_all(1);
			fbCurl.curl_easy_cleanup();
			sErrorText := 'Tidsavbrudd under innlogging';
			uiStep     := 900;
		END_IF

	// -----------------------------------------------------------------
	20:	// MODEM ID - start the request.
	//     The send endpoint needs to know which modem to use, and the id is
	//     not fixed: it depends on the hardware slot and can change after a
	//     router restart. Asking is more robust than hard coding.
	// -----------------------------------------------------------------
		sStatus   := 'Steg 20: henter modem-ID...';
		sResponse := '';

		fbCurl.curl_easy_init();
		fbCurl.curl_set_RAM(ADR(sResponse), SIZEOF(sResponse));
		fbCurl.curl_easy_setopt_BOOL(64, FALSE);
		fbCurl.curl_easy_setopt_BOOL(81, FALSE);
		fbCurl.curl_easy_setopt_DINT(13, TIME_TO_DINT(tRequestTimeout) / 1000);
		fbCurl.curl_easy_setopt_DINT(78, 10);
		fbCurl.curl_easy_setopt_DINT(80, 1);						// This one is a GET

		sURL := CONCAT('https://', sRouterIP);
		sURL := CONCAT(sURL, '/api/modems/status');
		fbCurl.curl_easy_setopt_STRING(10002, sURL);

		// Everything past the login is authenticated with the bearer token.
		sHeader := CONCAT('Authorization: Bearer ', sToken);
		fbCurl.curl_slist_append(1, sHeader);
		fbCurl.curl_easy_setopt_slist(10023, 1);

		fbCurl.curl_easy_perform();
		TON_Wait(IN := FALSE);
		uiStep := 21;

	// -----------------------------------------------------------------
	21:	// MODEM ID - wait, then take the first id the router reports.
	// -----------------------------------------------------------------
		TON_Wait(IN := TRUE, PT := tWaitTimeout);
		IF fbCurl.xDone OR fbCurl.xError THEN
			TON_Wait(IN := FALSE);

			diHttpCode    := LINT_TO_DINT(fbCurl.curl_easy_getResponseCode());
			xCurlError    := fbCurl.xError;
			sCurlError    := fbCurl.sErrorString;
			sCurlSource   := fbCurl.sErrorSource;
			sLastResponse := LEFT(sResponse, 200);

			fbCurl.curl_slist_free_all(1);
			fbCurl.curl_easy_cleanup();

			IF (diHttpCode = 401) AND NOT xRetriedLogin THEN
				// The cached token was refused, most likely because the router
				// restarted. Nothing was sent, so logging in again and repeating
				// this request is safe. Allowed only once per job.
				xTokenValid   := FALSE;
				sToken        := '';
				xRetriedLogin := TRUE;
				sStatus       := 'Token avvist - logger inn paa nytt';
				uiStep        := 10;
			ELSE
				sModemID := ExtractJson(sSource := sResponse, sKey := '"id"');
				IF LEN(sModemID) = 0 THEN
					// Same fallback the reference shell script uses. It is a
					// guess, and the router will reject it with 422 if wrong -
					// which at least says so clearly in sErrorText.
					sModemID := '1-1';
				END_IF
				uiStep := 30;
			END_IF

		ELSIF TON_Wait.Q THEN
			// Lookup timed out. Carry on with the fallback rather than failing
			// the whole job: the send step will report clearly if it is wrong.
			TON_Wait(IN := FALSE);
			fbCurl.curl_easy_abort();
			fbCurl.curl_slist_free_all(1);
			fbCurl.curl_easy_cleanup();
			sModemID := '1-1';
			uiStep   := 30;
		END_IF

	// -----------------------------------------------------------------
	30:	// SEND - start the request that actually delivers the message.
	// -----------------------------------------------------------------
		sStatus   := 'Steg 30: sender SMS...';
		sResponse := '';

		fbCurl.curl_easy_init();
		fbCurl.curl_set_RAM(ADR(sResponse), SIZEOF(sResponse));
		fbCurl.curl_easy_setopt_BOOL(64, FALSE);
		fbCurl.curl_easy_setopt_BOOL(81, FALSE);
		fbCurl.curl_easy_setopt_DINT(13, TIME_TO_DINT(tRequestTimeout) / 1000);
		fbCurl.curl_easy_setopt_DINT(78, 10);
		fbCurl.curl_easy_setopt_DINT(47, 1);

		sURL := CONCAT('https://', sRouterIP);
		sURL := CONCAT(sURL, '/api/messages/actions/send');
		fbCurl.curl_easy_setopt_STRING(10002, sURL);

		sHeader := CONCAT('Authorization: Bearer ', sToken);
		fbCurl.curl_slist_append(1, sHeader);
		fbCurl.curl_slist_append(1, 'Content-Type: application/json');
		fbCurl.curl_slist_append(1, 'Accept: */*');
		fbCurl.curl_easy_setopt_slist(10023, 1);
		// Some firmware versions refuse requests that carry no user agent.
		fbCurl.curl_easy_setopt_STRING(10018, 'curl/8.14.1');

		sBody := CONCAT('{"data":{"number":"', sNumber);
		sBody := CONCAT(sBody, '","message":"');
		sBody := CONCAT(sBody, sMessage);
		sBody := CONCAT(sBody, '","modem":"');
		sBody := CONCAT(sBody, sModemID);
		sBody := CONCAT(sBody, '"}}');
		fbCurl.curl_easy_setopt_STRING(10015, sBody);

		fbCurl.curl_easy_perform();
		TON_Wait(IN := FALSE);
		uiStep := 31;

	// -----------------------------------------------------------------
	31:	// SEND - wait for the router to accept or reject the message.
	//     This is the step where the duplicate question matters, because from
	//     here on the router may already have the message.
	// -----------------------------------------------------------------
		TON_Wait(IN := TRUE, PT := tWaitTimeout);
		IF fbCurl.xDone OR fbCurl.xError THEN
			TON_Wait(IN := FALSE);

			diHttpCode    := LINT_TO_DINT(fbCurl.curl_easy_getResponseCode());
			xCurlError    := fbCurl.xError;
			sCurlError    := fbCurl.sErrorString;
			sCurlSource   := fbCurl.sErrorSource;
			sLastResponse := LEFT(sResponse, 200);

			fbCurl.curl_slist_free_all(1);
			fbCurl.curl_easy_cleanup();

			IF FIND(sResponse, '"success":true') &gt; 0 THEN
				uiStep := 100;

			ELSIF (diHttpCode = 401) AND NOT xRetriedLogin THEN
				// Refused token. A 401 proves the router did NOT take the
				// message, so logging in again and repeating cannot duplicate it.
				xTokenValid   := FALSE;
				sToken        := '';
				xRetriedLogin := TRUE;
				sStatus       := 'Token avvist - logger inn paa nytt';
				uiStep        := 10;

			ELSE
				// Drop the cached modem id so the next attempt looks it up
				// again. If the id was the problem, repeating it is pointless.
				sModemID   := '';
				sErrorText := CONCAT('Sending feilet, HTTP ', DINT_TO_STRING(diHttpCode));
				IF diHttpCode = 0 THEN
					// The request went out but nothing came back. The router may
					// already have queued the SMS, so the outcome is genuinely
					// unknown and the caller must not repeat it.
					xSendUncertain := TRUE;
					sErrorText := CONCAT(sErrorText, ' USIKKER curl: ');
					sErrorText := CONCAT(sErrorText, LEFT(sCurlError, 100));
				ELSE
					// A real HTTP answer reporting failure. Nothing was sent,
					// so the caller is free to try again.
					sErrorText := CONCAT(sErrorText, ' svar: ');
					sErrorText := CONCAT(sErrorText, LEFT(sResponse, 110));
				END_IF
				uiStep := 900;
			END_IF

		ELSIF TON_Wait.Q THEN
			// Aborted mid transfer. Same reasoning as above: the router may or
			// may not have taken it, so the message is flagged as uncertain.
			TON_Wait(IN := FALSE);
			fbCurl.curl_easy_abort();
			fbCurl.curl_slist_free_all(1);
			fbCurl.curl_easy_cleanup();
			xSendUncertain := TRUE;
			sModemID       := '';
			sErrorText     := 'Tidsavbrudd under sending - USIKKER, ikke send paa nytt';
			uiStep         := 900;
		END_IF

	// -----------------------------------------------------------------
	100: // DONE - the router confirmed the message.
	// -----------------------------------------------------------------
		xDone      := TRUE;
		xBusy      := FALSE;
		udiSentCnt := udiSentCnt + 1;
		tLastSend  := WagoAppTime.FuGetLocalDateAndTime();
		sStatus    := 'SMS sendt OK';
		uiStep     := 0;

	// -----------------------------------------------------------------
	900: // ERROR - sErrorText was filled in by whichever step failed.
	// -----------------------------------------------------------------
		xError      := TRUE;
		xBusy       := FALSE;
		udiErrorCnt := udiErrorCnt + 1;
		sStatus     := sErrorText;
		uiStep      := 0;

ELSE
	// Unknown step. Reached only if an online change moves the code under a
	// running state machine. Returning to idle is always safe.
	uiStep := 0;
END_CASE</Single>
            <Single Name="LineInfoPersistence" Type="string">864d5513-663c-4b17-a53b-bd34f88f3083_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">(*
	FbTeltonikaSMS                      Created 20.08.2026, rev 22.08.2026
	==========================================================================
	WHAT THIS BLOCK DOES
	Sends ONE text message through a Teltonika RUTX router using its REST API.
	The router holds the SIM card, so the PLC needs no modem. Give it a number
	and a text, pulse xSend, and watch xDone or xError.

	Reference implementation: github.com/espenbo/wagoEdgeStart/TeltonikaRouter
	and the working /root/sendsms_busyboxV3.sh on this PLC. Both were used to
	prove the API flow before it was written in ST.

	THE API FLOW - THREE REQUESTS
	  1  POST /api/login                 user and password  -&gt;  bearer token
	  2  GET  /api/modems/status         token              -&gt;  modem id, 3-1 here
	  3  POST /api/messages/actions/send token, number, text, modem id
	The router answers the third with success true when it has accepted the SMS.

	*** WHY EVERY REQUEST IS SPLIT IN TWO STEPS ***
	WagoSysCurl.FbCurl is ASYNCHRONOUS. curl_easy_perform() only STARTS the
	transfer and returns immediately; the FB reports progress through xBusy,
	xDone and xError, and its body must be called every cycle for those to
	update. Reading curl_easy_getResponseCode() straight after perform therefore
	always yields 0 and an empty receive buffer - which looks exactly like a
	network failure and is extremely misleading. Each request is consequently a
	start step followed by a wait step:

	  10 login start   11 login wait
	  20 modem start   21 modem wait
	  30 send start    31 send wait
	 100 done         900 error

	Every wait step is bounded by tWaitTimeout, so a transfer that never
	completes cannot freeze the state machine.

	*** TOKEN CACHING ***
	The router reports expires 299, so a token is good for just under five
	minutes. Both the token and the detected modem id survive between messages,
	so a follow up message jumps straight to step 30: two steps and one network
	round trip instead of eight steps and three. If the router rejects a cached
	token with HTTP 401 the block logs in again once and repeats the request,
	which is safe because a 401 proves nothing was sent.

	*** DUPLICATE PROTECTION ***
	If the send request goes out and no answer comes back, the router may
	already have accepted the SMS. Repeating it would deliver the same message
	twice. That case raises xSendUncertain, and the caller must not retry while
	it is set. A clean HTTP answer reporting failure is safe to repeat.

	*** LENGTH LIMITS TO RESPECT ***
	CONCAT returns STRING(255) in CODESYS, so the assembled JSON body cannot
	exceed that. sMessage is therefore capped at 140 characters, which also
	keeps the SMS inside a single 160 character GSM message.
*)
FUNCTION_BLOCK FbTeltonikaSMS
VAR_INPUT
	// --- What to send, and where ---
	sRouterIP		: STRING(80);		// Router host name or IP. WITHOUT the https prefix,
										// the block adds that when building the URL.
	sUsername		: STRING(64);		// Router API user. Must have API rights - an ordinary
										// low privilege user is rejected with 401 code 120.
	sPassword		: STRING(64);		// Password for that user
	sNumber			: STRING(32);		// Recipient, international format, for example +47...
	sMessage		: STRING(140);		// The text itself. See the length note in the header.

	// --- Behaviour tuning ---
	sModemIdForced	: STRING(16) := '';	// Leave EMPTY for auto-detection, which is normal and
										// survives the id changing after a router restart.
										// Set it only to pin one specific modem.
	tRequestTimeout	: TIME := T#15S;	// Passed down to cURL as its own transfer timeout
	tWaitTimeout	: TIME := T#30S;	// Guard in the wait steps. Keep it LONGER than
										// tRequestTimeout, so cURL gets to fail on its own
										// terms first and can report a proper reason.
	tTokenLifetime	: TIME := T#4M;		// How long a token is reused before logging in again.
										// The router says 299 s, so stay safely below that.

	// --- Control ---
	xSend			: BOOL;				// RISING EDGE starts one send job. Level is ignored
										// while a job is already running.
END_VAR
VAR_OUTPUT
	// --- Job state ---
	xBusy			: BOOL;				// TRUE from the rising edge until done or failed
	xDone			: BOOL;				// Latched TRUE when the router confirmed the SMS.
										// Cleared when the next job starts.
	xError			: BOOL;				// Latched TRUE when the job failed. Read sErrorText.
	xSendUncertain	: BOOL;				// TRUE when the SMS may or may not have gone out.
										// The caller MUST NOT retry the message while set,
										// or the recipient can receive it twice.
	xTokenValid		: BOOL;				// TRUE while a cached token can still be reused

	// --- Human readable status ---
	sErrorText		: STRING(200);		// Why the last job failed, including HTTP code and,
										// where useful, the raw answer from the router
	sStatus			: STRING(200);		// Live progress text, useful on a visualization
	tLastSend		: DT;				// Time stamp of the last confirmed send

	// --- Counters, all since PLC start ---
	sModemID		: STRING(16);		// Modem id currently in use. Kept between messages so
										// the lookup runs once rather than every time.
	udiSentCnt		: UDINT;			// Messages the router confirmed
	udiErrorCnt		: UDINT;			// Jobs that ended in failure
	udiLoginCnt		: UDINT;			// Actual logins performed. Compare with udiSentCnt to
										// see token caching working: it should stay well below.

	// --- Raw diagnostics from the last completed request ---
	diHttpCode		: DINT;				// HTTP status. 0 is special: it means the transfer
										// never produced an HTTP answer at all, so look at
										// sCurlError instead of trying to interpret the code.
	xCurlError		: BOOL;				// libcurl reported a transport level error
	sCurlError		: STRING(200);		// libcurl error text. The real explanation whenever
										// diHttpCode is 0, for example a name resolution
										// failure or an SSL connect error.
	sCurlSource		: STRING(100);		// Where inside libcurl the error came from
	sLastResponse	: STRING(200);		// First 200 characters of the router answer, so a
										// rejection can be read without a network trace
	uiStepOut		: UINT;				// Mirror of the internal step, for commissioning
END_VAR
VAR
	fbCurl			: WagoSysCurl.FbCurl;	// The cURL handle. ASYNCHRONOUS - see header.
	uiStep			: UINT;				// State machine position, see the header for the map
	xSendPrev		: BOOL;				// Edge memory for xSend
	TON_Wait		: TON;				// Bounds each wait step, so a stalled transfer cannot
										// hold the state machine forever
	TON_TokenAge	: TON;				// Ages the cached token out after tTokenLifetime
	xRetriedLogin	: BOOL;				// Allows exactly ONE forced re-login per job after a
										// 401, so a stale token cannot cause an endless loop
	sResponse		: STRING(4095);		// Receive buffer for the HTTP body. Deliberately large:
										// the modem status answer carries many fields.
	sURL			: STRING(200);		// Assembled request URL
	sBody			: STRING(254);		// Assembled JSON request body. Sized just under the
										// 255 characters CONCAT can produce.
	sHeader			: STRING(250);		// Assembled Authorization header
	sToken			: STRING(200);		// Bearer token. Reused across messages until it ages
										// out or the router rejects it.
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">864d5513-663c-4b17-a53b-bd34f88f3083_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">2332</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">69ee38eb-31f8-40c0-8419-0949ffbab4c5</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">Teltonika</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">75e83a1f-4343-4f2d-8475-2bc2415b1fda</Single>
        <Single Name="ParentGuid" Type="System.Guid">74e3e49e-7ef8-4c33-9830-fee5aedb6d38</Single>
        <Single Name="Name" Type="string">prg_AlarmSMS</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">69ee38eb-31f8-40c0-8419-0949ffbab4c5</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639231152803132170</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// =====================================================================
// 1) Resolve which router host to talk to.
//    The local override wins, or if it is emty use so GVL_TeltonikaCredentials.Teltonika_sRouterIP
// =====================================================================
IF LEN(sRouterOverride) &gt; 0 THEN
	sRouterInUse := sRouterOverride;
ELSE
	sRouterInUse := GVL_TeltonikaCredentials.Teltonika_sRouterIP;
END_IF

// Without credentials every login is doomed, and each doomed attempt costs a
// network round trip and fills the diagnostics with noise. Detect it once here
// and let section 6 hold the queue instead.
xCredentialsMissing := (LEN(GVL_TeltonikaCredentials.Teltonika_Username) = 0)
					OR (LEN(GVL_TeltonikaCredentials.Teltonika_Password) = 0);

// =====================================================================
// 2) Rolling one hour window behind the rate limit.
//    A free running timer is enough: it does not matter exactly where the
//    hour boundary falls, only that the counter cannot grow forever.
// =====================================================================
TON_HourWindow(IN := TRUE, PT := T#1H);
IF TON_HourWindow.Q THEN
	TON_HourWindow(IN := FALSE);	// Restart the window
	iSentThisHour := 0;
END_IF

// =====================================================================
// 3) Build the time stamp that goes into every message.
//    DT_TO_STRING has a fixed layout, so the parts can be cut out by
//    position instead of parsed:
//        DT#2026-08-20-14:20:28
//            ^4      ^9 ^12 ^15
// =====================================================================
sRaw   := DT_TO_STRING(WagoAppTime.FuGetLocalDateAndTime());
sStamp := CONCAT(MID(sRaw, 2, 12), '.');		// Two digits of day
sStamp := CONCAT(sStamp, MID(sRaw, 2, 9));		// Two digits of month
sStamp := CONCAT(sStamp, ' ');
sStamp := CONCAT(sStamp, MID(sRaw, 5, 15));		// Five characters, hh:mm

// =====================================================================
// 4) Scan every alarm slot and queue messages for the transitions.
//    Calling the slot updates its debounce timer and its edge outputs, so
//    all the per alarm timing logic lives in the slot rather than here.
//    Only transitions produce messages: a standing alarm stays silent.
// =====================================================================
iEnabledCount := 0;
iActiveCount  := 0;

FOR i := 1 TO MAX_ALARMS DO

	aAlarm[i]();			// Debounce and edge detection happen inside the slot
	xQueueIt := FALSE;

	// Two counters for the overview screen, so the operator can see at a
	// glance how much of the system is armed and how much is in alarm.
	IF aAlarm[i].xSmsEnable THEN
		iEnabledCount := iEnabledCount + 1;
	END_IF
	IF aAlarm[i].xActive THEN
		iActiveCount := iActiveCount + 1;
	END_IF

	IF xSmsGlobalEnable AND aAlarm[i].xSmsEnable THEN
		IF aAlarm[i].xRising THEN
			// The alarm has just appeared.
			sMsg     := CONCAT(sSiteName, ' ');
			sMsg     := CONCAT(sMsg, sStamp);
			sMsg     := CONCAT(sMsg, ' ALARM: ');
			sMsg     := CONCAT(sMsg, aAlarm[i].sText);
			xQueueIt := TRUE;
		ELSIF aAlarm[i].xFalling AND xSendOkMessages THEN
			// The alarm has cleared. Optional, because on a noisy signal this
			// doubles the number of messages.
			sMsg     := CONCAT(sSiteName, ' ');
			sMsg     := CONCAT(sMsg, sStamp);
			sMsg     := CONCAT(sMsg, ' OK: ');
			sMsg     := CONCAT(sMsg, aAlarm[i].sText);
			xQueueIt := TRUE;
		END_IF
	END_IF

	IF xQueueIt THEN
		// The message is embedded in a JSON body, where a double quote would
		// end the string early and corrupt the request. Replace any with
		// spaces. The guard counter bounds the loop so malformed text can
		// never stall the task.
		iGuard := 0;
		iQuote := FIND(sMsg, '"');
		WHILE (iQuote &gt; 0) AND (iGuard &lt; 20) DO
			sMsg   := REPLACE(sMsg, ' ', 1, iQuote);
			iQuote := FIND(sMsg, '"');
			iGuard := iGuard + 1;
		END_WHILE

		IF LEN(sMsg) &gt; MSG_MAX_LEN THEN
			sMsg := LEFT(sMsg, MSG_MAX_LEN);
		END_IF

		// One queue entry per selected recipient. Two conditions have to agree:
		// the person must be in service at all (axRecipientEnable) AND this
		// particular alarm must be addressed to them (axToRecipient). Queueing
		// per recipient rather than per alarm keeps the sender simple: it never
		// has to know that one alarm can have several destinations.
		FOR iRcp := 1 TO MAX_RECIPIENTS DO
			IF axRecipientEnable[iRcp]
				AND aAlarm[i].axToRecipient[iRcp]
				AND (LEN(asRecipientNumber[iRcp]) &gt; 0) THEN

				IF iQueueCount &lt; QUEUE_SIZE THEN
					iQTail            := (iQTail MOD QUEUE_SIZE) + 1;	// Ring buffer wrap
					aQueueMsg[iQTail] := sMsg;
					aQueueNo[iQTail]  := asRecipientNumber[iRcp];
					iQueueCount       := iQueueCount + 1;
				ELSE
					// Queue full. Counting the loss is better than blocking the
					// task or discarding it unnoticed.
					udiDropped := udiDropped + 1;
				END_IF
			END_IF
		END_FOR
	END_IF
END_FOR

// =====================================================================
// 5) Manual test message.
//    Two destinations from one button:
//      sTestNumber empty     -&gt; every enabled recipient, which proves the
//                               real alarm path exactly as an alarm would use it
//      sTestNumber filled in -&gt; only that number, for checking a new phone
//                               before it is added to the recipient list
//    iTestQueued reports back how many messages were actually queued, so a
//    press that produced nothing is visible rather than silent.
// =====================================================================
IF xManualSend AND NOT xManualPrev THEN
	sMsg := CONCAT(sSiteName, ' ');
	sMsg := CONCAT(sMsg, sStamp);
	sMsg := CONCAT(sMsg, ' TEST: ');
	sMsg := CONCAT(sMsg, sManualText);

	// Same sanitizing as a real alarm, because the operator types this text
	// and a double quote would corrupt the JSON body just the same.
	iGuard := 0;
	iQuote := FIND(sMsg, '"');
	WHILE (iQuote &gt; 0) AND (iGuard &lt; 20) DO
		sMsg   := REPLACE(sMsg, ' ', 1, iQuote);
		iQuote := FIND(sMsg, '"');
		iGuard := iGuard + 1;
	END_WHILE

	IF LEN(sMsg) &gt; MSG_MAX_LEN THEN
		sMsg := LEFT(sMsg, MSG_MAX_LEN);
	END_IF

	iTestQueued := 0;

	IF LEN(sTestNumber) &gt; 0 THEN
		// A number was typed in, so send only there.
		IF iQueueCount &lt; QUEUE_SIZE THEN
			iQTail            := (iQTail MOD QUEUE_SIZE) + 1;
			aQueueMsg[iQTail] := sMsg;
			aQueueNo[iQTail]  := sTestNumber;
			iQueueCount       := iQueueCount + 1;
			iTestQueued       := 1;
		ELSE
			udiDropped := udiDropped + 1;
		END_IF
	ELSE
		// No number typed, so send to everyone who is enabled - the same set
		// an alarm addressed to all four recipients would reach.
		FOR iRcp := 1 TO MAX_RECIPIENTS DO
			IF axRecipientEnable[iRcp] AND (LEN(asRecipientNumber[iRcp]) &gt; 0) THEN
				IF iQueueCount &lt; QUEUE_SIZE THEN
					iQTail            := (iQTail MOD QUEUE_SIZE) + 1;
					aQueueMsg[iQTail] := sMsg;
					aQueueNo[iQTail]  := asRecipientNumber[iRcp];
					iQueueCount       := iQueueCount + 1;
					iTestQueued       := iTestQueued + 1;
				ELSE
					udiDropped := udiDropped + 1;
				END_IF
			END_IF
		END_FOR
	END_IF
END_IF
xManualPrev := xManualSend;
xManualSend := FALSE;			// Clear it again so the button is momentary

// =====================================================================
// 6) The sender.
//    Strictly one message at a time. The send FB can only handle one job, and
//    serialising here also means the router is never hit by parallel requests.
//
//    RETRY POLICY, and why it is not simply MAX_RETRY attempts:
//    Repeating a request is only safe when we KNOW nothing was sent. A login
//    failure, or a rejection carrying a real HTTP status, both mean the router
//    did nothing, so those are retried. But if the send request went out and
//    no answer came back, the router may already have queued the SMS -
//    repeating it would deliver the same message twice. The send FB flags that
//    case with xSendUncertain, and such a message is dropped and counted.
// =====================================================================
CASE iSendState OF

	// -----------------------------------------------------------------
	0:	// Idle. Take the next message out of the queue if everything allows it.
	// -----------------------------------------------------------------
		xSendTrigger := FALSE;
		xRateLimited := (iSentThisHour &gt;= iMaxSmsPerHour) AND (iQueueCount &gt; 0);

		IF (iQueueCount &gt; 0)
			AND xSmsGlobalEnable
			AND NOT xRateLimited
			AND NOT xCredentialsMissing THEN

			iQHead      := (iQHead MOD QUEUE_SIZE) + 1;		// Ring buffer wrap
			sCurMsg     := aQueueMsg[iQHead];
			sCurNo      := aQueueNo[iQHead];
			iQueueCount := iQueueCount - 1;
			iRetry      := 0;
			iSendState  := 10;
		END_IF

	// -----------------------------------------------------------------
	10:	// Start one attempt. Raising xSendTrigger gives the send FB the rising
	//     edge it needs; it stays TRUE until the job finishes.
	// -----------------------------------------------------------------
		sLastMessage := sCurMsg;
		xSendTrigger := TRUE;
		iSendState   := 20;

	// -----------------------------------------------------------------
	20:	// Wait for the verdict. The send FB is asynchronous and advances one
	//     step per call, so this state is held for several cycles.
	// -----------------------------------------------------------------
		IF oSms.xDone THEN
			xSendTrigger  := FALSE;
			udiSentOk     := udiSentOk + 1;
			iSentThisHour := iSentThisHour + 1;
			iSendState    := 30;

		ELSIF oSms.xError THEN
			xSendTrigger := FALSE;
			sLastError   := oSms.sErrorText;

			IF oSms.xSendUncertain THEN
				// Unknown outcome, see the retry policy above. The hour slot is
				// counted as used as well, because the message probably did cost
				// an SMS and the rate limit should not underestimate usage.
				udiUncertain  := udiUncertain + 1;
				iSentThisHour := iSentThisHour + 1;
				iSendState    := 30;

			ELSIF iRetry &lt; MAX_RETRY THEN
				// Known failure, nothing was sent, so trying again is safe.
				iRetry     := iRetry + 1;
				iSendState := 40;

			ELSE
				// Out of attempts. Give up on this one and move on, rather than
				// letting a single bad message block the whole queue.
				udiSendFailed := udiSendFailed + 1;
				iSendState    := 30;
			END_IF
		END_IF

	// -----------------------------------------------------------------
	30:	// Pause between messages. Two purposes: breathing room for the router,
	//     and it guarantees at least one cycle with xSendTrigger FALSE so the
	//     next message produces a genuine rising edge.
	// -----------------------------------------------------------------
		TON_Pause(IN := TRUE, PT := tPauseBetweenSms);
		IF TON_Pause.Q THEN
			TON_Pause(IN := FALSE);
			iSendState := 0;
		END_IF

	// -----------------------------------------------------------------
	40:	// Wait before repeating the same message, so a brief outage has time
	//     to clear instead of burning all attempts in a few seconds.
	// -----------------------------------------------------------------
		TON_Retry(IN := TRUE, PT := tRetryDelay);
		IF TON_Retry.Q THEN
			TON_Retry(IN := FALSE);
			iSendState := 10;
		END_IF

ELSE
	// Unknown state. Reached only after an online change moves the code under
	// a running state machine. Returning to idle is always safe.
	iSendState := 0;
END_CASE

// =====================================================================
// 7) Call the router client.
//    This MUST run every cycle, including when idle: the underlying cURL
//    transfer is asynchronous and only advances when the FB body executes.
// =====================================================================
oSms(
	sRouterIP      := sRouterInUse,
	sUsername      := GVL_TeltonikaCredentials.Teltonika_Username,
	sPassword      := GVL_TeltonikaCredentials.Teltonika_Password,
	sNumber        := sCurNo,
	sMessage       := sCurMsg,
	sModemIdForced := sModemIdForced,
	xSend          := xSendTrigger);

// Mirror the interesting outputs so a visualization can bind them here rather
// than reaching into the FB instance. Everything else is still reachable as
// oSms.&lt;name&gt;, for example oSms.udiLoginCnt and oSms.xTokenValid.
sSmsStatus := oSms.sStatus;
sCurlError := oSms.sCurlError;		// The one that explains a diHttpCode of 0
diHttpCode := oSms.diHttpCode;
uiSendStep := oSms.uiStepOut;		// 10 and 11 login, 20 and 21 modem, 30 and 31 send</Single>
            <Single Name="LineInfoPersistence" Type="string">75e83a1f-4343-4f2d-8475-2bc2415b1fda_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">(*
	prg_AlarmSMS                        Created 20.08.2026, rev 23.08.2026
	==========================================================================
	WHAT THIS PROGRAM DOES
	It turns boolean alarm conditions into text messages, and hands them one at
	a time to FbTeltonikaSMS, which talks to a Teltonika RUTX09 router
	over its REST API. The router holds the SIM card, so the PLC needs no modem.

	THE CHAIN, IN ORDER
	  aAlarm[i].xAlarmIn        a condition in the plant becomes TRUE
	  aAlarm[i]                 the slot debounces it and produces xActive plus
	                            the one shot edges xRising and xFalling
	  aAlarm[i].xSmsEnable      the operator switch: may this alarm send at all?
	  aAlarm[i].axToRecipient[] one BOOL per person, picking who gets this alarm
	  aQueueMsg / aQueueNo      a FIFO, because sending takes seconds and alarms
	                            can arrive in bursts
	  oSms                      the router client, driven one message at a time

	WHY EACH ALARM IS A FUNCTION BLOCK INSTANCE
	The CODESYS Best Practices for visualization recommend passing ONE parameter
	to a reusable visualization through VAR_IN_OUT. A slot instance is exactly
	that: a frame showing one row references prg_AlarmSMS.aAlarm[i] and
	gets every field of that alarm with it.

	WHY THE RECIPIENT SELECTION IS AN ARRAY OF BOOL
	Changed 23.08.2026 from a BYTE bit mask. A mask is compact but hostile to a
	visualization: a checkbox has to bind to a single bit, the operator sees a
	meaningless number, and an off by one in the bit index is invisible until
	the wrong person is woken up. One BOOL per recipient binds directly to a
	checkbox and reads the same way in the code.

	WHY A QUEUE AND A RATE LIMIT
	One message needs several task cycles and up to three network round trips.
	Without a queue a burst of alarms would overwrite each other. Without
	iMaxSmsPerHour a chattering signal could send hundreds of messages, which
	costs real money and buries the operator in noise.

	NOTE ON LANGUAGE
	Comments are English. Operator facing texts are deliberately Norwegian,
	because sText goes straight into an SMS that a Norwegian recipient reads.
*)
PROGRAM prg_AlarmSMS
VAR CONSTANT
	// Sizes are constants so the arrays, the loops and the visualization all
	// agree on one number. MAX_RECIPIENTS must match the array size declared
	// inside FbAlarmSlot - raise both together if more than four
	// people need alarms.
	MAX_ALARMS		: INT := 20;	// Alarm slots available for configuration
	MAX_RECIPIENTS	: INT := 4;		// Phone numbers that can receive alarms
	QUEUE_SIZE		: INT := 16;	// Messages that can wait before one is lost
	MAX_RETRY		: INT := 2;		// Extra attempts, and only for KNOWN failures.
									// See the retry policy in section 6 below.
	MSG_MAX_LEN		: INT := 140;	// Message cap. CONCAT returns STRING(255) in
									// CODESYS and the whole JSON body must fit in
									// that, so the text itself is capped here.
END_VAR

VAR
	// =================================================================
	// 1) THE ALARM TABLE
	// -----------------------------------------------------------------
	// One FbAlarmSlot per alarm. Each slot carries its own
	// configuration AND its own live state, and does its own debouncing.
	//
	// Wire your plant conditions into the slots from anywhere in the project:
	//   prg_AlarmSMS.aAlarm[1].xAlarmIn := NOT HTTP_HvaKosterStrommen.xPriceDataValid;
	//
	// A visualization row binds to one whole slot as a single reference:
	//   alarm  -&gt;  prg_AlarmSMS.aAlarm[1]
	//
	// iDelaySec is in SECONDS: 30 is thirty seconds, 120 is two minutes,
	// 300 is five minutes. The slot renders it back as readable text.
	//
	// The recipient selection is NOT set here. Every slot falls back to the
	// default declared in the function block, which is recipient 1 only.
	// Change it per alarm from the visualization, or add axToRecipient to the
	// lines below if a different default suits the plant better.
	//
	// Only slots 1 to 3 are enabled. The rest are written but switched off,
	// because an alarm whose xAlarmIn is not wired yet should not be able to
	// send anything. Enable each one as you connect its signal.
	// =================================================================
	aAlarm : ARRAY[1..MAX_ALARMS] OF FbAlarmSlot := [
		// --- Energi og pris ---
		(xSmsEnable := TRUE,  iDelaySec := 300,
		 sText := 'Stroempriser ikke oppdatert fra hvakosterstrommen.no'),
		(xSmsEnable := TRUE,  iDelaySec := 120,
		 sText := 'Solcelleanlegg: ingen Modbus-kontakt'),
		(xSmsEnable := TRUE,  iDelaySec := 120,
		 sText := 'MQTT-forbindelse mot skyen er nede'),
		(xSmsEnable := FALSE, iDelaySec := 30,
		 sText := 'Hoey stroempris - forbruk boer reduseres'),

		// --- Energimaalere, stigere ---
		(xSmsEnable := FALSE, iDelaySec := 120,
		 sText := 'Energimaaler stiger 433.101 og 433.201 svarer ikke'),
		(xSmsEnable := FALSE, iDelaySec := 120,
		 sText := 'Energimaaler stiger 433.102 og 433.202 svarer ikke'),
		(xSmsEnable := FALSE, iDelaySec := 120,
		 sText := 'Energimaaler stiger 433.103 svarer ikke'),
		(xSmsEnable := FALSE, iDelaySec := 120,
		 sText := 'Energimaaler stiger 433.104 svarer ikke'),
		(xSmsEnable := FALSE, iDelaySec := 120,
		 sText := 'Energimaaler stiger 433.203 svarer ikke'),
		(xSmsEnable := FALSE, iDelaySec := 120,
		 sText := 'Energimaaler stiger 434.001 svarer ikke'),

		// --- Varme ---
		(xSmsEnable := FALSE, iDelaySec := 120,
		 sText := 'Elkjele: ingen kontakt med energimaaler'),
		(xSmsEnable := FALSE, iDelaySec := 120,
		 sText := 'Varmepumpe: ingen kontakt med energimaaler'),

		// --- Ventilasjon ---
		(xSmsEnable := FALSE, iDelaySec := 120,
		 sText := 'Ventilasjonsaggregat 360.003 svarer ikke'),
		(xSmsEnable := FALSE, iDelaySec := 120,
		 sText := 'Ventilasjonsaggregat 360.004 svarer ikke'),
		(xSmsEnable := FALSE, iDelaySec := 120,
		 sText := 'Ventilasjonsaggregat 360.005 svarer ikke'),

		// --- Varmtvann og feltbuss ---
		(xSmsEnable := FALSE, iDelaySec := 120,
		 sText := 'Varmtvannsbereder CH124 svarer ikke'),
		(xSmsEnable := FALSE, iDelaySec := 60,
		 sText := 'Modbus RTU-linje 1: kommunikasjonsfeil'),
		(xSmsEnable := FALSE, iDelaySec := 120,
		 sText := 'Teltonika-ruter: ingen Modbus-kontakt'),

		// --- Reserve ---
		(xSmsEnable := FALSE, iDelaySec := 30,
		 sText := 'Reserve - ledig alarmplass 19'),
		(xSmsEnable := FALSE, iDelaySec := 30,
		 sText := 'Reserve - ledig alarmplass 20')];

	// =================================================================
	// 2) RECIPIENTS
	// -----------------------------------------------------------------
	// Three parallel arrays, index 1 to 4. A recipient must be enabled here
	// AND selected in the slot before anything is sent, so one person can be
	// taken out of service without editing every alarm.
	//
	// In a visualization, bind a CHECKBOX to axRecipientEnable[n], and text
	// fields with %s to the name and the number.
	// =================================================================
	axRecipientEnable	: ARRAY[1..MAX_RECIPIENTS] OF BOOL       := [TRUE, FALSE, FALSE, FALSE];	// On or off per person
	asRecipientName		: ARRAY[1..MAX_RECIPIENTS] OF STRING(20) := ['Espen', '', '', ''];			// Display only, never sent
	asRecipientNumber	: ARRAY[1..MAX_RECIPIENTS] OF STRING(24) := ['+4791916159', '', '', ''];	// International format, this is what is dialled

	// =================================================================
	// 3) GENERAL SETTINGS
	// =================================================================
	xSmsGlobalEnable	: BOOL := TRUE;			// Master switch. FALSE stops all sending and all
												// queueing - use it during service work.
	xSendOkMessages		: BOOL := TRUE;			// Also send a message when an alarm clears, so the
												// operator knows the fault went away.
	sSiteName			: STRING(20) := 'PFC300';	// Prefix in every message. Essential when one
												// phone receives alarms from several plants.
	iMaxSmsPerHour		: INT := 15;			// Hard ceiling per rolling hour, against runaway cost
	tPauseBetweenSms	: TIME := T#10S;		// Gap between messages. Gives the router time to hand
												// the previous one over, and guarantees a clean edge.
	tRetryDelay			: TIME := T#60S;		// Wait before repeating a message that failed for a
												// known reason, so a brief outage can recover.

	// Leave EMPTY to fall back
	// to GVL_TeltonikaCredentials.Teltonika_sRouterIP.
	sRouterOverride		: STRING(80) := '';

	// Modem id inside the router. Leave EMPTY for auto-detection, which is
	// normal and survives the id changing after a router restart.
	sModemIdForced		: STRING(16) := '';

	// =================================================================
	// STATUS AND DIAGNOSTICS
	// -----------------------------------------------------------------
	// Read only. These exist to be bound to a visualization, and to make a
	// failure explain itself without a debugger attached.
	// =================================================================
	sRouterInUse			: STRING(80);	// Host actually used, after the override is resolved
	xCredentialsMissing		: BOOL;			// TRUE when user name or password is blank. Blocks
											// sending so the queue is not burned on doomed logins.
	iQueueCount				: INT;			// Messages waiting right now
	xRateLimited			: BOOL;			// TRUE when the hourly ceiling holds messages back
	iSentThisHour			: INT;			// Counter behind the ceiling, reset once an hour
	iEnabledCount			: INT;			// How many of the twenty alarms are switched on. Handy
											// as a single number on an overview screen.
	iActiveCount			: INT;			// How many alarms are standing right now
	udiSentOk				: UDINT;		// Messages the router confirmed, since PLC start
	udiSendFailed			: UDINT;		// Messages given up on after all allowed retries
	udiUncertain			: UDINT;		// Messages whose fate is unknown - the request went out
											// but no answer came back. Never retried, to avoid
											// sending the same SMS twice.
	udiDropped				: UDINT;		// Messages never queued because the FIFO was full
	sLastMessage			: STRING(140);	// Exact text last handed to the router
	sLastError				: STRING(200);	// Why the last attempt failed
	sSmsStatus				: STRING(200);	// Live progress text from the send FB
	sCurlError				: STRING(200);	// Raw libcurl error. The one to read when diHttpCode
											// stays 0, because then there is no HTTP answer.
	diHttpCode				: DINT;			// HTTP status of the last request. 0 means the request
											// never produced an HTTP answer at all.
	uiSendStep				: UINT;			// Live step inside the send FB: 10 and 11 login,
											// 20 and 21 modem lookup, 30 and 31 the send itself.

	// =================================================================
	// MANUAL TEST
	// -----------------------------------------------------------------
	// One button, two destinations. Leave sTestNumber EMPTY and the test goes
	// to every enabled recipient, which proves the real alarm path end to end.
	// Type a number into sTestNumber and it goes only there, which is how you
	// check a new phone before adding it to the recipient list.
	// xManualSend is self resetting, so a visualization button only has to
	// toggle it and the program clears it again on the next cycle.
	// =================================================================
	xManualSend			: BOOL;								// Set TRUE to queue one test message
	sTestNumber			: STRING(24) := '';					// Optional. Empty means all enabled recipients.
	sManualText			: STRING(100) := 'Testmelding fra PFC300';	// Body of the test message
	iTestQueued			: INT;								// How many messages the last test queued,
															// so the operator sees it did something

	// =================================================================
	// INTERNALS - not intended for the visualization
	// =================================================================
	aQueueMsg			: ARRAY[1..QUEUE_SIZE] OF STRING(140);	// FIFO slot: the message text
	aQueueNo			: ARRAY[1..QUEUE_SIZE] OF STRING(24);	// FIFO slot: the recipient number.
																// Kept beside the text so one alarm
																// to three people becomes three
																// independent queue entries.
	iQHead				: INT;					// Last slot read from, wraps at QUEUE_SIZE
	iQTail				: INT;					// Last slot written to, wraps at QUEUE_SIZE

	oSms				: FbTeltonikaSMS;	// The router client. Called every cycle so its
													// asynchronous transfer can advance.
	xSendTrigger		: BOOL;					// Rising edge starts oSms. Held TRUE for the whole
												// job and cleared afterwards, so the next message
												// gets a fresh edge.
	iSendState			: INT;					// Sender state machine, see section 6
	iRetry				: INT;					// Attempts already used on the current message
	sCurMsg				: STRING(140);			// The message being sent right now
	sCurNo				: STRING(24);			// The recipient it is going to

	TON_Pause			: TON;					// Enforces tPauseBetweenSms between messages
	TON_Retry			: TON;					// Enforces tRetryDelay before a repeat attempt
	TON_HourWindow		: TON;					// Free running one hour timer that clears
												// iSentThisHour, implementing the rate limit

	xManualPrev			: BOOL;					// Edge memory for xManualSend
	i					: INT;					// Loop counter over the alarm slots
	iRcp				: INT;					// Loop counter over the recipients. NOTE: a bare
												// r cannot be used as an identifier - CODESYS
												// reserves R and S as the IL reset and set
												// operators, and the parser fails cryptically.
	iGuard				: INT;					// Safety counter so the sanitize loop can never
												// spin forever on malformed text
	iQuote				: INT;					// Position of the next double quote to remove
	xQueueIt			: BOOL;					// Set when the slot being scanned needs sending
	sMsg				: STRING(140);			// Message being assembled
	sStamp				: STRING(30);			// Time stamp for the message, format dd.mm hh:mm
	sRaw				: STRING(40);			// Raw DT_TO_STRING output the stamp is cut from
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">75e83a1f-4343-4f2d-8475-2bc2415b1fda_Decl_LineIds</Single>
          </Single>
